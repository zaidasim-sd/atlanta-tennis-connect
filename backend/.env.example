# ─── Atlanta Tennis Backend – Environment Variables ──────────────────────────
# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control.

# MongoDB Atlas connection string.
# IMPORTANT: Use the "atlanta-tennis" database name, NOT the Stripe PoC database.
# The two databases live on the same Atlas cluster but are fully isolated.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/atlanta-tennis?appName=<appName>

# Payment adapter: mock, stripe, or worldpay.
# Always use "mock" during load tests – the real Stripe sandbox must never
# receive synthetic concurrent load.
PAYMENT_PROVIDER=stripe

# Stripe credentials (only used when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Local server port
PORT=3001

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
# Exact additional browser origins, comma-separated. No wildcard Vercel hosts.
ALLOWED_ORIGINS=

# Node environment
NODE_ENV=development

# Reservation TTL – held slots expire after this many minutes without payment
RESERVATION_TTL_MINUTES=15

# Organisers use server-authenticated accounts, never a shared admin key.

# Cron job authorization secret (Vercel passes this as "Bearer <secret>")
CRON_SECRET=change-me-in-production

# Optional: inject a payment failure rate for load tests (0.0 – 1.0)
# 0.05 = 5% of mock payments fail, exercising the slot-restore path
MOCK_FAILURE_RATE=0

# Worldpay Express Hosted Payments (only used when PAYMENT_PROVIDER=worldpay).
# Hosted Payments API key is the Express AccountToken, not an Access Worldpay key.
WORLDPAY_HOSTED_PAYMENTS_API_KEY=
WORLDPAY_HOSTED_PAYMENTS_ACCEPTOR_ID=
WORLDPAY_HOSTED_PAYMENTS_APP_ID=
WORLDPAY_HOSTED_PAYMENTS_ACCOUNT_ID=
WORLDPAY_ENVIRONMENT=sandbox
# Confirm the currency assigned to this Express merchant before production.
WORLDPAY_MERCHANT_CURRENCY=USD
WORLDPAY_TERMINAL_ID=0001
# Optional: defaults to CLIENT_URL. Must be the public frontend origin in deployment.
WORLDPAY_RETURN_ORIGIN=
