# ─── Atlanta Tennis Backend – Environment Variables ──────────────────────────
# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control.

# MongoDB Atlas connection string.
# IMPORTANT: Use the "atlanta-tennis" database name, NOT the Stripe PoC database.
# The two databases live on the same Atlas cluster but are fully isolated.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/atlanta-tennis?appName=<appName>

# Payment adapter: "mock" for load tests, "stripe" for real payments.
# Always use "mock" during load tests – the real Stripe sandbox must never
# receive synthetic concurrent load.
PAYMENT_PROVIDER=stripe

# Stripe credentials (only used when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Local server port
PORT=3001

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
# Exact additional browser origins, comma-separated. No wildcard Vercel hosts.
ALLOWED_ORIGINS=
# Vercel deployment origins are read from VERCEL_URL, VERCEL_BRANCH_URL,
# and VERCEL_PROJECT_PRODUCTION_URL. Add other project URLs to ALLOWED_ORIGINS.

# Optional session cookie overrides for cross-origin or custom domain deployments
# Defaults: "__Host-atl-session" in production ("atl-session" in dev), sameSite "lax", path "/"
#
# WARNING – SESSION_COOKIE_NAME:
#   The default "__Host-" prefix (RFC 6265bis §4.1.3) provides host-binding and
#   requires Secure + Path=/ + no Domain attribute. Overriding this to a name
#   without the prefix in production is a security downgrade: the cookie will
#   still be Secure and HttpOnly, but loses host-binding enforcement.
#   Only override if your deployment cannot satisfy __Host- requirements
#   (e.g. HTTP-only staging or a reverse-proxy that strips the Secure flag).
SESSION_COOKIE_NAME=
SESSION_COOKIE_SAMESITE=lax
# NOTE – SESSION_COOKIE_DOMAIN:
#   Ignored automatically when SESSION_COOKIE_NAME starts with "__Host-".
#   Only takes effect for non-prefixed cookie names.
SESSION_COOKIE_DOMAIN=

# Node environment
NODE_ENV=development

# Reservation TTL – held slots expire after this many minutes without payment
RESERVATION_TTL_MINUTES=15

# Organisers use server-authenticated accounts, never a shared admin key.

# Cron job authorization secret (Vercel passes this as "Bearer <secret>")
CRON_SECRET=change-me-in-production

# Optional: inject a payment failure rate for load tests (0.0 – 1.0)
# 0.05 = 5% of mock payments fail, exercising the slot-restore path
MOCK_FAILURE_RATE=0
