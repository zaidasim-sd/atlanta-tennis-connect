{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/expire", "schedule": "0 0 * * *" },
    { "path": "/api/cron/reconcile", "schedule": "0 1 * * *" }
  ]
}
