{
  "name": "atlanta-tennis-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Atlanta Tennis Connect – real backend API for staging load tests",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/reservations.test.cjs tests/auth.test.cjs tests/worldpay.test.cjs",
    "test:unit": "npm run build && node --test tests/zip-area-capacity.test.cjs tests/gender.test.cjs",
    "test:stripe-concurrency": "node tests/run-stripe-concurrency.cjs",
    "start": "node dist/server.js",
    "seed": "ts-node --transpile-only scripts/seed.ts",
    "seed:reset": "ts-node --transpile-only scripts/seed.ts --reset",
    "test:worldpay": "npm run build && node --test tests/worldpay.test.cjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.2",
    "mongoose": "^8.5.1",
    "stripe": "^16.2.0",
    "uuid": "^10.0.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "^10.4.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
