# ─── Baseline ATL Frontend – Environment Variables ──────────────────────────
# Copy this file to .env.local for local overrides.
# Do not commit secrets to this file.

# Target API URL for local Vite dev proxy.
# Leave blank in production so frontend requests stay same-origin (/api/*).
# In local development, defaults to http://localhost:3001 if omitted.
VITE_API_URL=

# Optional Nitro deployment preset (default: "vercel").
# Change this when compiling for an alternate host:
#   "vercel"           -> Vercel Build Output API v3 (.vercel/output)
#   "node-server"      -> Standalone Node.js server (.output/server)
#   "netlify"          -> Netlify edge/functions (.netlify)
#   "cloudflare-pages" -> Cloudflare Pages
NITRO_PRESET=vercel
