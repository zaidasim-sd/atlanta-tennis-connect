{
  "version": 2,
  "rewrites": [
    { "source": "/api/auth/:path+", "destination": "/api/auth" },
    { "source": "/api/leagues/:path+", "destination": "/api/leagues" },
    { "source": "/api/players/:path+", "destination": "/api/players" },
    { "source": "/api/payments/:path+", "destination": "/api/payments" },
    { "source": "/api/registrations/:path+", "destination": "/api/registrations" },
    { "source": "/api/seasons/:path+", "destination": "/api/season-configuration" },
    { "source": "/api/playoff-opt-ins", "destination": "/api/season-configuration" },
    { "source": "/api/playoff-opt-ins/:path+", "destination": "/api/season-configuration" },
    { "source": "/api/season-one", "destination": "/api/season-one" },
    { "source": "/api/organization", "destination": "/api/season-configuration" }
  ],
  "crons": [
    { "path": "/api/cron/expire", "schedule": "0 0 * * *" },
    { "path": "/api/cron/reconcile", "schedule": "0 1 * * *" }
  ]
}
